{
  "app": "bstage",
  "platform": "docker",
  "port": 8080,
  "build": { "location": "iran" },
  "disks": [
    { "name": "creator", "mountTo": "/data/creator" }
  ],
  "healthCheck": {
    "command": "CMD curl --fail http://localhost:8080 || exit 1",
    "interval": 30000,
    "timeout": 8000,
    "retries": 3,
    "startPeriod": 3000
  }
}
