{
  "app": "bstage",
  "platform": "docker",
  "port": 8080,
  "build": { "location": "iran" },
  "disks": [
    { "name": "creator", "mountTo": "/data/creator" }
  ],
  "healthCheck": {
    "command": "CMD node -e \"fetch('http://127.0.0.1:8080/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
    "interval": 30000,
    "timeout": 8000,
    "retries": 3,
    "startPeriod": 3000
  }
}
