{
  "app": "bstage",
  "platform": "docker",
  "port": 8080,
  "build": { "location": "iran" },
  "disks": [
    { "name": "creator", "mountTo": "/data/creator" }
  ],
  "healthCheck": {
    "command": "CMD node /stage/launcher.mjs health",
    "interval": 30, 
    "timeout": 15,
    "retries": 2,
    "startPeriod": 5
  }
}
